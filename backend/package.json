{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "seed": "tsx src/seed.ts",
    "e2e:reset-and-serve": "node -e \"require('fs').rmSync(process.env.DB_PATH,{force:true});require('fs').rmSync(process.env.DB_PATH+'-wal',{force:true});require('fs').rmSync(process.env.DB_PATH+'-shm',{force:true})\" && tsx src/seed.ts && tsx src/server.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  }
}
